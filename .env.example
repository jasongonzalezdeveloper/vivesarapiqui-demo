# Clave de Google Maps JavaScript API (https://developers.google.com/maps/documentation/javascript/get-api-key)
# Sin clave, el demo muestra un mapa ilustrado de respaldo.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Map ID para marcadores avanzados y estilos en la nube (opcional; por defecto DEMO_MAP_ID)
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
